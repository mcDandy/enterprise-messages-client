    <!-- One Android KeyStore identity per device: it is handed to the server as one account\'s
         public key at registration, so a second account signing in here would inherit chat keys it
         does not own and be unable to send or read anything. Switching is an explicit reset below. -->
    <string name="error_device_bound_to_other_account">This device belongs to the account %1$s. Log out and reset its
        encryption identity in Settings before signing in as somebody else.
    </string>
    <string name="error_device_bound_for_register">This device already belongs to the account %1$s. Reset its encryption
        identity in Settings before registering another account.
    </string>

