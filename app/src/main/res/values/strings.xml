    <string name="backup_error_short_passphrase">Use at least 8 characters</string>
    <string name="backup_error_mismatch">The passphrases do not match</string>
    <string name="backup_warning">The file contains the keys that decrypt your chats. Store it outside the phone; the passphrase is its only protection.</string>

    <!-- The only supported way to hand the device to another account: the identity key and every
         key sealed with it are deleted, which is irreversible by design. -->
    <string name="settings_identity_title">Device identity</string>
    <string name="action_reset_identity">Reset encryption identity</string>
    <string name="dialog_reset_identity_title">Reset encryption identity?</string>
    <string name="dialog_reset_identity_body">This device is bound to the account %1$s. Resetting deletes its identity key and every chat key sealed with it. Messages stay undecryptable for you and for everybody you wrote to; there is no undo and the server cannot restore them.</string>
    <string name="dialog_reset_identity_body_unbound">This deletes the device\'s identity key and every chat key sealed with it. Messages stay undecryptable for you and for everybody you wrote to; there is no undo and the server cannot restore them.</string>
    <string name="identity_reset_done">The device identity and its chat keys were deleted</string>
    <string name="identity_reset_failed">The device identity could not be deleted; try again</string>

