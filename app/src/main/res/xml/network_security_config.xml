<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Only system-installed certificate authorities are trusted and cleartext (http://, ws://)
        is forbidden. Trusting <certificates src="user"/> would let any app or tool that installs
        a root CA on the device (the standard technique behind cheap TLS-inspection proxies)
        silently decrypt the login password, the JWT and every chat payload.

        The deployment is reachable at https://TLS_HOST:HTTPS_PORT (see the server's compose.yaml),
        so cleartext is never required.

        Debug builds additionally accept user-installed CAs via <debug-overrides> below, which the
        Debug builds additionally accept the development certificate that the server exports
        (scripts/start-and-export-cert.ps1 writes app/src/main/res/raw/devserver.crt) plus any
        user-installed CA, via <debug-overrides> below. The platform applies those overrides only
        when android:debuggable="true", so a release build keeps trusting system CAs alone and can
        never be pointed at a dev server or intercepted by a proxy.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
            <certificates src="@raw/devserver"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
