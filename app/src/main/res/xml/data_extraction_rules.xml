<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules. The app sets android:allowBackup="false", so these rules are a second
   line of defence: they keep the account and sealed-secret files out of a cloud backup or a device
   transfer even if backup is ever re-enabled. The KeyStore key that seals those files does not
   travel with a backup, so a restored copy would be useless anyway.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="EnterpriseMessenger_Account.xml" />
        <exclude domain="sharedpref" path="EnterpriseMessenger_Secrets.xml" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="sharedpref" path="EnterpriseMessenger_Account.xml" />
        <exclude domain="sharedpref" path="EnterpriseMessenger_Secrets.xml" />
    </device-transfer>
</data-extraction-rules>
